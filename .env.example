DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional. If set, signup requires this code.
SIGNUP_ACCESS_CODE=change-me
INTERNAL_API_SECRET=change-me
CRON_SECRET=change-me
TRACKING_BASE_URL=https://your-vercel-app.vercel.app
INBOXES_CONFIG_PATH=./config/inboxes.json
# For Vercel/Render, prefer this instead of a local config/inboxes.json file:
# INBOXES_JSON=[{"id":"mail","address":"hello@example.com","smtpHost":"smtp.example.com","smtpPort":587,"username":"hello@example.com","password":"password","imapHost":"imap.example.com","imapPort":993,"warmupStartDate":"2026-05-14","active":true}]

# Display name on outgoing mail (From header). Default: Curtis from AI-Automated
SENDER_DISPLAY_NAME=Curtis from AI-Automated

# Optional. If omitted, replies go to the sending inbox.
# REPLY_TO_EMAIL=

# Optional reply notifications. Uses NOTIFICATION_INBOX_ID or the first active inbox to send alerts.
NOTIFICATION_EMAIL=you@example.com
NOTIFICATION_INBOX_ID=

SEND_WINDOW_START_HOUR=8
SEND_WINDOW_END_HOUR=18
SEND_WEEKDAYS_ONLY=true
# IANA timezone for send window and daily reset (default: America/Los_Angeles = Pacific)
SEND_TIMEZONE=America/Los_Angeles

# Seconds to wait between sends in one run (SMTP itself is fast; spacing is intentional)
SEND_DELAY_MIN_SECONDS=20
SEND_DELAY_MAX_SECONDS=45
# Emails per cron/manual run (hourly cron finishes the daily budget across runs)
MAX_SENDS_PER_RUN=10

# Dev-only: send on weekends / off-hours / one campaign (Campaigns page UI + POST /api/send)
ALLOW_DEV_SEND_OVERRIDE=false
# Optional default campaign ID for dev send (shown in UI when set)
# DEV_SEND_CAMPAIGN_ID=3
# DEV_SEND_MAX_PER_RUN=50
# DEV_SEND_SKIP_DELAYS=true

# Open-tracking pixel base URL — must be this app (or a domain that proxies to it). No trailing slash.
# Pixel URL in mail: {TRACKING_BASE_URL}/api/track/{uuid}
# TRACKING_BASE_URL=https://your-vercel-app.vercel.app
